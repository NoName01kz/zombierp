rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /materials/{materialId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 30000
        && request.resource.data.category in [
          'articles','bestiary','characters','locations','anomalies',
          'items','factions','rules','news','updates'
        ];
      allow update: if isAdmin()
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAdmin();
    }

    // Admin documents are created manually in Firebase Console by the project owner.
    // No client-side user can grant themselves administrator access.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
